generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum EventType {
  CONFERENCE
  WORKSHOP
  SEMINAR
  TRAINING
  WEBINAR
  NETWORKING
  EXHIBITION
  WEDDING
  BIRTHDAY
  CORPORATE
  COMMUNITY
  OTHER
}

enum EventMode {
  ONLINE
  PHYSICAL
  HYBRID
}

enum RegistrationType {
  FREE
  TICKETED
  APPLICATION
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  REGISTERED
  CANCELLED
  CHECKED_IN
}

enum BusinessType {
  SALON
  CLINIC
  SPA
  GYM
  CONSULTATION
  OTHER
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  role      UserRole @default(BUSINESS_OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   BusinessMember[]
  staffProfiles Staff[]

  @@map("users")
}

model Business {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  type             BusinessType     @default(OTHER)
  description      String?
  shortDescription String?
  logo             String?
  coverImage       String?
  phone            String?
  email            String?
  website          String?
  address          String?
  city             String?
  region           String?
  country          String?
  googleMapsLink   String?
  instagram        String?
  facebook         String?
  tiktok           String?
  whatsapp         String?
  gallery          String?   // JSON array of image URLs
  bio              String?   // Longer personal/professional bio
  yearsOfExperience Int?
  specialties      String?   // Comma-separated
  languages        String?   // Comma-separated
  certifications   String?   // JSON array of {name, issuer, year}
  profileVisibility  ProfileVisibility @default(PUBLIC)
  bookingVisibility  ProfileVisibility @default(PUBLIC)
  bookingLink      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  members        BusinessMember[]
  services       Service[]
  staff          Staff[]
  customers      Customer[]
  appointments   Appointment[]
  workingHours   WorkingHours[]
  profile        BusinessProfile?
  bookingSettings BookingSettings?
  reviews        Review[]
  events         Event[]
  payments       Payment[]

  @@map("businesses")
}

model BusinessMember {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       UserRole @default(BUSINESS_OWNER)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("business_members")
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  category        String?
  price           Decimal  @db.Decimal(12, 2)
  duration        Int
  deposit         Decimal? @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  availableOnline Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       StaffService[]
  appointments Appointment[]

  @@map("services")
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  name       String
  title      String?
  phone      String?
  email      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])
  services    StaffService[]
  appointments Appointment[]
  workingHours WorkingHours[]

  @@map("staff")
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model WorkingHours {
  id         String   @id @default(cuid())
  businessId String?
  staffId    String?
  day        WeekDay
  startTime  String
  endTime    String
  isOff      Boolean  @default(false)
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("working_hours")
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([businessId, phone])
  @@map("customers")
}

model Appointment {
  id         String            @id @default(cuid())
  businessId String
  customerId String
  serviceId  String
  staffId    String
  date       DateTime
  startTime  String
  endTime    String
  status     AppointmentStatus @default(PENDING)
  notes      String?
  phone      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Notification {
  id         String   @id @default(cuid())
  businessId String
  type       String
  channel    String
  recipient  String
  message    String
  isSent     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("notifications")
}

model SubscriptionPlan {
  id       String  @id @default(cuid())
  name     String
  price    Decimal @db.Decimal(12, 2)
  interval String
  features String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id         String    @id @default(cuid())
  businessId String
  planId     String
  status     String    @default("active")
  startDate  DateTime  @default(now())
  endDate    DateTime?
  createdAt  DateTime  @default(now())

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Payment {
  id         String  @id @default(cuid())
  businessId String
  amount     Decimal @db.Decimal(12, 2)
  method     String
  status     String  @default("pending")
  type       String  @default("SUBSCRIPTION")
  reference  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  businessId  String
  customerName String
  customerPhone String?
  customerEmail String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("TZS")
  method      String   @default("CASH")
  status      String   @default("PENDING")
  reference   String?
  serviceName String?
  eventId     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_transactions")
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model BusinessProfile {
  id             String   @id @default(cuid())
  businessId     String   @unique
  seoTitle       String?
  metaDescription String?
  focusKeywords  String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  canonicalUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model BookingSettings {
  id                       String   @id @default(cuid())
  businessId               String   @unique
  bookingEnabled           Boolean  @default(true)
  advanceBookingDays       Int      @default(30)
  minimumNoticeHours       Int      @default(2)
  cancellationAllowed      Boolean  @default(true)
  cancellationDeadlineHours Int     @default(6)
  reschedulingAllowed      Boolean  @default(true)
  noShowProtection         Boolean  @default(true)
  requirePhone             Boolean  @default(true)
  requireEmail             Boolean  @default(false)
  bufferMinutes            Int      @default(0)
  maxDailyBookings         Int      @default(50)
  allowDoubleBooking       Boolean  @default(false)
  autoConfirm              Boolean  @default(true)
  requireStaffSelection    Boolean  @default(false)
  allowCustomerNotes       Boolean  @default(true)
  paymentMode              String   @default("PAY_AT_VENUE")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("booking_settings")
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  customerName String
  customerPhone String?
  rating     Int
  comment    String?
  reply      String?
  isReported Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Event {
  id              String           @id @default(cuid())
  businessId      String
  title           String
  slug            String
  description     String?
  coverImage      String?
  category        EventType        @default(OTHER)
  mode            EventMode        @default(PHYSICAL)
  registrationType RegistrationType @default(FREE)
  startDate       DateTime
  endDate         DateTime
  location        String?
  onlineLink      String?
  capacity        Int              @default(0)
  isPublished     Boolean          @default(true)
  isRegistrationOpen Boolean       @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tickets        EventTicket[]
  registrations  EventRegistration[]

  @@unique([businessId, slug])
  @@map("events")
}

model EventTicket {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int      @default(0)
  soldCount   Int      @default(0)
  description String?
  createdAt   DateTime @default(now())

  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@map("event_tickets")
}

model EventRegistration {
  id          String             @id @default(cuid())
  eventId     String
  ticketId    String?
  fullName    String
  email       String
  phone       String
  organization String?
  occupation  String?
  motivation  String?
  status      RegistrationStatus @default(REGISTERED)
  ticketNumber String?
  qrCode      String?
  checkedIn   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket EventTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@map("event_registrations")
}
